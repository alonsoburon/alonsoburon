---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog');
const sorted = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function postNumber(slug: string) {
  const m = slug.match(/^(\d+)/);
  return m ? m[1] : '0000';
}
---

<Layout title="Writing — Alonso Burón" path="~/blog/" active="blog">
  <div class="content">
    <div class="h-row">
      <span class="anchor"># </span>
      <span class="h1-inner"><span class="key">Writing</span></span>
      <span class="inline-comment">{`<!-- ${sorted.length} posts -->`}</span>
    </div>

    <p class="lede" style="max-width:55ch">
      Notes on data engineering, distributed systems, and the occasional detour
      through music theory and career.
    </p>

    <div class="card-list">
      {sorted.map((post) => (
        <a href={`/blog/${post.slug}`} class="card-title-link">
          <article class="card">
            <div class="card-head">
              <span class="sx c-dim">{postNumber(post.slug)}</span>
              <span style="margin-left:auto" class="sx c-muted">{post.data.date}</span>
            </div>
            <div class="card-body">
              <div class="card-row">
                <span class="anchor">## </span>
                <span class="h3">{post.data.title}</span>
              </div>
              {post.data.description && (
                <p class="card-desc">{post.data.description}</p>
              )}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="tag-row">
                  {post.data.tags.map((t: string) => <span class="tag">#{t}</span>)}
                </div>
              )}
            </div>
          </article>
        </a>
      ))}
    </div>
  </div>
</Layout>
