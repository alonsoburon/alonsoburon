---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const path = `~/blog/${post.slug}.md`;
const filename = `${post.slug}.md`;

// Try to derive a single italic "key" word for the title (last word fallback).
const titleParts = post.data.title.split(' ');
const titleHead = titleParts.slice(0, -1).join(' ');
const titleKey = titleParts[titleParts.length - 1];

// Simple read-time estimate
const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readMin = Math.max(1, Math.round(wordCount / 220));
---

<Layout
  title={`${post.data.title} — Alonso Burón`}
  description={post.data.description ?? post.data.title}
  path={path}
  active="blog"
>
  <div class="content-reading">
    <div class="breadcrumb">
      <span class="sx c-cmt">cd </span>
      <a href="/blog" class="sx c-link">../blog</a>
      <span class="sx c-dim"> / </span>
      <span class="sx c-accent">{filename}</span>
    </div>

    <div class="h-row">
      <span class="anchor"># </span>
      <span class="h1-blog">
        {titleHead}{titleHead && ' '}<span class="key">{titleKey}</span>
      </span>
    </div>

    <div class="post-meta">
      <span><span class="sx c-cmt">date: </span><span class="sx c-num">{post.data.date}</span></span>
      <span><span class="sx c-cmt">read: </span><span class="sx c-text3">{readMin} min</span></span>
      {post.data.tags && post.data.tags.length > 0 && (
        <span>
          <span class="sx c-cmt">tags: </span>
          <span class="sx c-str">[{post.data.tags.map((t: string) => `"${t}"`).join(',')}]</span>
        </span>
      )}
    </div>

    <article class="post-body">
      <Content />
    </article>

    <div class="section" style="border-top:1px dashed var(--border); padding-top:18px">
      <a href="/blog" class="sx c-link" style="text-decoration:underline; text-underline-offset:3px">
        ← cd ../blog
      </a>
    </div>
  </div>
</Layout>
