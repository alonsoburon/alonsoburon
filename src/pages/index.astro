---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = await getCollection('blog');
const recent = posts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

function shortDate(d: string) {
  return d.slice(0, 7); // YYYY-MM
}

function postNumber(slug: string) {
  const m = slug.match(/^(\d+)/);
  return m ? m[1] : '0000';
}
---

<Layout
  title="Alonso Burón — Lead Data Engineer in Santiago, Chile"
  path="~/cv.md"
  active="cv"
  kind="profile"
>
  <div class="content">
    <!-- H1 -->
    <div class="h-row">
      <span class="anchor"># </span>
      <span class="h1">Alonso <span class="key">Burón</span></span>
      <span class="cursor"></span>
    </div>

    <p class="lede">
      Lead Data Engineer at <span class="sx c-cmt">[</span><a class="md-link" href="https://datawalt.cl" target="_blank" rel="noopener">Datawalt</a><span class="sx c-cmt">](https://datawalt.cl)</span>, classically trained
      composer, running on an Arch pendrive. Developing a big data platform that consolidates 
      <span class="sx c-cmt">`</span><code>60+ enterprise systems</code><span class="sx c-cmt">`</span>
      into multiple data warehouses.
    </p>

    <!-- Currently -->
    <div class="section">
      <div class="h-row">
        <span class="anchor">## </span>
        <span class="h2">Currently</span>
        <span class="inline-comment">{`<!-- since 2024-10 -->`}</span>
      </div>
      <div class="fence">
        <div class="fence-head">
          <span><span class="sx c-cmt">```</span><span class="sx c-fn">yaml</span></span>
          <span class="sx c-dim">frontmatter · current.yml</span>
        </div>
        <div class="fence-body">
          <span class="c-kw">role:</span>      <span class="c-str">"Data Engineering Lead"</span>
          <span class="c-kw">company:</span>   <span class="c-str">"Datawalt"</span>
          <span class="c-kw">since:</span>     <span class="c-num">2024-10</span>
          <span class="c-kw">building:</span>  <span class="c-str">["Warp · "ECL Framework" · "Competing with Fivetran"]</span>
          <span class="c-kw">favorite RDB:</span> <span class="c-str">"PostgreSQL for row-based, CH for columnar"</span>
        </div>
      </div>
    </div>

    <!-- Stack -->
    <div class="section">
      <div class="h-row">
        <span class="anchor">## </span>
        <span class="h2">Stack</span>
        <span class="inline-comment">{`<!-- top of mind -->`}</span>
      </div>
      <ul class="stack-list">
        <li>
          <span class="sx c-cmt">- </span>
          <div>
            <strong class="stack-key c-accent">warehouses</strong><span class="sx c-cmt">: </span>
            <span class="c-text2">BigQuery · Clickhouse · DuckDB</span>
          </div>
        </li>
        <li>
          <span class="sx c-cmt">- </span>
          <div>
            <strong class="stack-key c-fn">orchestration</strong><span class="sx c-cmt">: </span>
            <span class="c-text2">Dagster · Prefect · DolphinScheduler</span>
          </div>
        </li>
        <li>
          <span class="sx c-cmt">- </span>
          <div>
            <strong class="stack-key c-link">languages</strong><span class="sx c-cmt">: </span>
            <span class="c-text2">Python · Go · SQL · TS</span>
          </div>
        </li>
        <li>
          <span class="sx c-cmt">- </span>
          <div>
            <strong class="stack-key c-text3">tooling</strong><span class="sx c-cmt">: </span>
            <span class="c-text2">Zed · Helium · Arch · Plasma 6</span>
          </div>
        </li>
      </ul>
    </div>

    <!-- Education -->
    <div class="section">
      <div class="h-row">
        <span class="anchor">## </span>
        <span class="h2">Education</span>
      </div>
      <div class="fence" style="margin-top:14px">
        <div class="fence-head">
          <span><span class="sx c-cmt">```</span><span class="sx c-fn">yaml</span></span>
          <span class="sx c-dim">education.yml</span>
        </div>
        <div class="fence-body">
          <span class="c-kw">composition:</span>
          <span><span class="c-str">"PUCCh · Music Composition"</span> <span class="c-cmt">// 2019-2023</span></span>
          <span class="c-kw">data_science:</span>
          <span><span class="c-str">"PUCCh · Data Science Diploma"</span> <span class="c-cmt">// 2023-2024</span></span>
          <span class="c-kw">bsc_data_sci:</span>
          <span><span class="c-str">"IU International · Data Scientist"</span> <span class="c-cmt">// 2024-2026 (Incomplete)</span></span>
        </div>
      </div>
    </div>

    <!-- Recent writing -->
    <div class="section">
      <div class="h-row">
        <span class="anchor">## </span>
        <span class="h2">Recent <span class="key">writing</span></span>
      </div>
      <ul class="writing-list">
        {recent.map((post) => (
          <li class="writing-row">
            <span class="sx c-dim">{postNumber(post.slug)}</span>
            <span>
              <span class="sx c-cmt">[</span>
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              <span class="sx c-cmt">]</span>
            </span>
            <span class="sx c-muted">{shortDate(post.data.date)}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>
