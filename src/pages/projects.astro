---
import Layout from '../layouts/Layout.astro';
import { openSourceProjects, closedSourceProjects } from '../data/projects';

type Kind = 'oss' | 'closed-source';

const all: Array<{
  title: string;
  period: string;
  role: string;
  description: string;
  achievements: string[];
  tech?: string[];
  githubUrl?: string;
  publishedAt?: Date;
  kind: Kind;
}> = [
  ...openSourceProjects.map((p) => ({ ...p, kind: 'oss' as const })),
  ...closedSourceProjects.map((p) => ({ ...p, kind: 'closed-source' as const })),
]
  .filter((p) => p.publishedAt)
  .sort((a, b) => b.publishedAt!.getTime() - a.publishedAt!.getTime());

const ossCount    = all.filter((p) => p.kind === 'oss').length;
const closedCount = all.filter((p) => p.kind === 'closed-source').length;
---

<Layout title="Projects — Alonso Burón" path="~/projects.md" active="projects">
  <div class="content">
    <div class="h-row">
      <span class="anchor"># </span>
      <span class="h1-inner"><span class="key">Projects</span></span>
      <span class="inline-comment">{`<!-- ${closedCount} closed-source · ${ossCount} OSS -->`}</span>
    </div>

    <div class="filter-row">
      <span class="sx c-cmt">$ filter</span>
      <button class="chip active" data-filter="all">--all</button>
      <button class="chip" data-filter="oss">--oss</button>
      <button class="chip" data-filter="closed-source">--closed</button>
      <button class="chip" id="sort-toggle" style="margin-left:auto" data-dir="desc">
        sort: <span class="c-text3" id="sort-label">recent ↓</span>
      </button>
    </div>

    <div class="card-list" id="project-list">
      {all.map((p) => (
        <article class="card project-card" data-kind={p.kind} data-date={p.publishedAt!.toISOString()}>
          <div class="card-head">
            <span><span class="sx c-cmt">```</span><span class="sx c-fn">project</span></span>
            <span class="c-dim">· {p.kind}</span>
            <span style="margin-left:auto" class="c-muted">{p.period}</span>
          </div>
          <div class="card-body">
            <div class="card-row">
              <span class="anchor">### </span>
              {p.githubUrl ? (
                <a href={p.githubUrl} target="_blank" rel="noopener" class="card-title-link">
                  <span class="h3">{p.title}</span>
                </a>
              ) : (
                <span class="h3">{p.title}</span>
              )}
              {p.role && (
                <div class="card-role">
                  <span class="sx c-muted">role: </span><span class="sx c-link">"{p.role}"</span>
                </div>
              )}
            </div>
            <p class="card-desc">{p.description}</p>
            {p.achievements?.length > 0 && (
              <div class="tag-row">
                {p.achievements.map((a) => <span class="tag achievement">{a}</span>)}
              </div>
            )}
            {p.tech && p.tech.length > 0 && (
              <div class="tag-row">
                {p.tech.map((t) => <span class="tag">{t}</span>)}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  <script>
    function initProjects() {
      const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-filter]');
      const cards = document.querySelectorAll<HTMLElement>('.project-card');
      const list  = document.getElementById('project-list');
      const sortBtn = document.getElementById('sort-toggle') as HTMLButtonElement | null;
      const sortLabel = document.getElementById('sort-label');
      if (!list) return;

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.remove('active'));
          chip.classList.add('active');
          const f = chip.dataset.filter;
          cards.forEach((c) => {
            c.style.display = (f === 'all' || c.dataset.kind === f) ? '' : 'none';
          });
        });
      });

      if (sortBtn && sortLabel) {
        sortBtn.addEventListener('click', () => {
          const dir = sortBtn.dataset.dir === 'desc' ? 'asc' : 'desc';
          sortBtn.dataset.dir = dir;
          sortLabel.textContent = dir === 'desc' ? 'recent ↓' : 'recent ↑';
          const sorted = Array.from(cards).sort((a, b) => {
            const da = Date.parse(a.dataset.date || '');
            const db = Date.parse(b.dataset.date || '');
            return dir === 'desc' ? db - da : da - db;
          });
          sorted.forEach((c) => list.appendChild(c));
        });
      }
    }
    document.addEventListener('astro:page-load', initProjects);
  </script>
</Layout>
