---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  path?: string;
  active?: 'cv' | 'projects' | 'blog' | 'contact';
}

const {
  title,
  description = "Lead Data Engineer · CV and portfolio",
  path = '~/cv.md',
  active = 'cv',
} = Astro.props;

const NAV = [
  { key: 'cv',       name: 'cv',       href: '/' },
  { key: 'projects', name: 'projects', href: '/projects' },
  { key: 'blog',     name: 'blog',     href: '/blog' },
  { key: 'contact',  name: 'contact',  href: '/contact' },
] as const;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500;1,9..144,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <div id="app">
      <header id="topbar">
        <span class="path">{path}</span>
        <span class="sep">·</span>
        <span class="conf">{`{ render: "preview", source: "visible" }`}</span>
        <nav>
          {NAV.map(({ key, name, href }) => (
            <span class="nav-item">
              <span class="br">[</span>
              <a href={href} class={key === active ? 'active' : ''}>{name}</a>
              <span class="br">](</span>
              <span class="url">{href}</span>
              <span class="br">)</span>
            </span>
          ))}
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer id="foot">
        <span class="rendered">● rendered</span>
        <span>shiki · github-dark</span>
        <span>view-transitions: on</span>
        <span class="copy">©2026 Burón · MIT</span>
      </footer>
    </div>
  </body>
</html>
