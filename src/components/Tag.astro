---
export interface Props {
  variant?: "default" | "tech" | "achievement" | "period" | "role" | "warn";
}
const { variant = "default" } = Astro.props;
---
<span class={`tag tag-${variant}`}>
  <slot />
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    padding: 0.18rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-bg-raised);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .tag-tech {
    color: var(--gb-aqua);
    border-color: rgba(142, 192, 124, 0.35);
    background: rgba(142, 192, 124, 0.08);
  }
  .tag-achievement {
    color: var(--gb-green);
    border-color: rgba(184, 187, 38, 0.35);
    background: rgba(184, 187, 38, 0.08);
  }
  .tag-period {
    color: var(--gb-fg3);
    background: var(--gb-bg1);
  }
  .tag-role {
    color: var(--gb-yellow);
    border-color: rgba(250, 189, 47, 0.35);
    background: rgba(250, 189, 47, 0.08);
  }
  .tag-warn {
    color: var(--gb-orange);
    border-color: rgba(254, 128, 25, 0.35);
    background: rgba(254, 128, 25, 0.08);
  }
</style>
