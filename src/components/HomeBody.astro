---
/**
 * HomeBody.astro — the CV page, in whichever locale it is handed.
 *
 * Both /  and /es/ render this. Keeping one template means the two locales
 * cannot drift apart structurally; only the strings differ.
 */
import { getCollection } from 'astro:content';
import { projects, localizeProject } from '../data/projects';
import { routes } from '../i18n/config';
import { useUi } from '../i18n/ui';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useUi(lang).home;

const featured = projects
  .filter((p) => p.featured && p.publishedAt)
  .sort((a, b) => b.publishedAt!.getTime() - a.publishedAt!.getTime());

const posts = await getCollection('blog');
const recent = posts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

function shortDate(d: string) {
  return d.slice(0, 7); // YYYY-MM
}

function postNumber(slug: string) {
  const m = slug.match(/^(\d+)/);
  return m ? m[1] : '0000';
}
---

<div class="content">
  <!-- H1 -->
  <div class="h-row">
    <span class="anchor"># </span>
    <span class="h1">Alonso <span class="key">Burón</span></span>
    <span class="cursor"></span>
  </div>

  <p class="lede">
    {t.ledeRole}{' '}
    <span class="sx c-cmt">[</span><a class="md-link" href="https://datawalt.cl" target="_blank" rel="noopener">Datawalt</a><span class="sx c-cmt">](https://datawalt.cl)</span>{t.ledeAfterLink}{' '}
    <span class="sx c-cmt">`</span><code>{t.ledeCode}</code><span class="sx c-cmt">`</span>{' '}
    {t.ledeTail}
  </p>

  <!-- Currently -->
  <div class="section">
    <div class="h-row">
      <span class="anchor">## </span>
      <span class="h2">{t.currently}</span>
      <span class="inline-comment">{`<!-- ${t.currentlySince} -->`}</span>
    </div>
    <div class="fence">
      <div class="fence-head">
        <span><span class="sx c-cmt">```</span><span class="sx c-fn">yaml</span></span>
        <span class="sx c-dim">{t.currentFile}</span>
      </div>
      <div class="fence-body">
        <span class="c-kw">{t.k.role}</span>      <span class="c-str">"{t.v.role}"</span>
        <span class="c-kw">{t.k.company}</span>   <span class="c-str">"Datawalt"</span>
        <span class="c-kw">{t.k.since}</span>     <span class="c-num">2024</span>
        <span class="c-kw">{t.k.building}</span>  <span class="c-str">{t.v.building}</span>
        <span class="c-kw">{t.k.favoriteRdb}</span> <span class="c-str">"{t.v.favoriteRdb}"</span>
      </div>
    </div>
  </div>

  <!-- Selected projects -->
  <div class="section">
    <div class="h-row">
      <span class="anchor">## </span>
      <span class="h2">{t.projectsTitle} <span class="key">{t.projectsKey}</span></span>
    </div>
    <div class="card-list">
      {featured.map((p) => {
        const l = localizeProject(p, lang);
        return (
          <article class="card project-card">
            <div class="card-head">
              <span><span class="sx c-cmt">```</span><span class="sx c-fn">project</span></span>
              <span class="c-dim">· {l.role}</span>
              <span style="margin-left:auto" class="c-muted">{l.period}</span>
            </div>
            <div class="card-body">
              <div class="card-row">
                <span class="anchor">### </span>
                {p.githubUrl || p.homepage ? (
                  <a href={p.githubUrl ?? p.homepage} target="_blank" rel="noopener" class="card-title-link">
                    <span class="h3">{p.title}</span>
                  </a>
                ) : (
                  <span class="h3">{p.title}</span>
                )}
              </div>
              <p class="card-desc">{l.description}</p>
              {p.tech && p.tech.length > 0 && (
                <div class="tag-row">
                  {p.tech.map((tech) => <span class="tag">{tech}</span>)}
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
    <p style="margin-top:14px">
      <span class="sx c-cmt">[</span>
      <a class="md-link" href={routes.projects[lang]}>{t.projectsAll}</a>
      <span class="sx c-cmt">]</span>
    </p>
  </div>

  <!-- Recent writing. The articles themselves are English-only. -->
  <div class="section">
    <div class="h-row">
      <span class="anchor">## </span>
      <span class="h2">{t.recentWritingA} <span class="key">{t.recentWritingB}</span></span>
    </div>
    <ul class="writing-list">
      {recent.map((post) => (
        <li class="writing-row">
          <span class="sx c-dim">{postNumber(post.slug)}</span>
          <span>
            <span class="sx c-cmt">[</span>
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            <span class="sx c-cmt">]</span>
          </span>
          <span class="sx c-muted">{shortDate(post.data.date)}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
